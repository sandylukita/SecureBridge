# SecureBridge Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ─────────────────────────────────────────────────────
# LLM Configuration
# ─────────────────────────────────────────────────────

# Anthropic Claude API (cloud mode)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# LLM Mode: auto | cloud | air-gapped
# auto     = CRITICAL → Claude, others → Ollama
# cloud    = Always use Claude API
# air-gapped = Always use Ollama (no internet required)
SECUREBRIDGE_MODE=auto

# ─────────────────────────────────────────────────────
# Alert Channels (optional)
# ─────────────────────────────────────────────────────

# Email alerts
EMAIL_FROM=securebridge@yourcompany.com
EMAIL_PASSWORD=your_email_password
EMAIL_TO=security@yourcompany.com

# Telegram bot alerts
# Create bot: https://t.me/BotFather
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ─────────────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────────────

# Dashboard port (default 8501)
DASHBOARD_PORT=8501

# Ollama host (docker service name)
OLLAMA_HOST=http://ollama:11434
